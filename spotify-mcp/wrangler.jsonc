{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spotify-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-14",
  "compatibility_flags": ["nodejs_compat"],
  "kv_namespaces": [
    {
      "binding": "SPOTIFY_TOKENS",
      "id": "cef4cd87e5a440919941e9624a5ca695"
    }
  ],
  "services": [
    {
      "binding": "AUTH_SERVER",
      "service": "spotify-auth"
    }
  ],
  "vars": {
    "AUTH_SERVER_URL": "https://spotify-auth.charrienacor.workers.dev",
    "MCP_SERVER_URL": "https://spotify-mcp.charrienacor.workers.dev/mcp"
  },
  "observability": {
    "enabled": true
  }
}
